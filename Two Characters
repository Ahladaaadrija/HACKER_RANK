#
# Complete the 'alternate' function below.
#
# The function is expected to return an INTEGER.
# The function accepts STRING s as parameter.
#

def alternate(s):
    newlist = list(s)
    newset = list(set(newlist))
    lenset = len(newset)

    p = []

    for i in range(lenset):
        for j in range(i + 1, lenset):

            a = newset[i]
            b = newset[j]

            temp = []

            for x in newlist:
                if x == a or x == b:
                    temp.append(x)

            valid = True

            for k in range(1, len(temp)):
                if temp[k] == temp[k-1]:
                    valid = False
                    break

            if valid:
                p.append(len(temp))

    return max(p) if p else 0
if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    l = int(input().strip())

    s = input()

    result = alternate(s)

    fptr.write(str(result) + '\n')

    fptr.close()
